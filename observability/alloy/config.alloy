// Drive 수집 파이프라인 — "입구(가져오기·받기·읽기) → 가공 → 출구(저장소별 전송)" 선을 직접 잇는다.
// 화면에서 확인: http://localhost:12345 (컴포넌트별 상태·연결 그래프)

logging {
  level  = "info"
  format = "logfmt"
}

// ───────────────────────────── 출구: 저장소 3곳 ─────────────────────────────

// 메트릭 → Prometheus (remote_write = push)
prometheus.remote_write "default" {
  endpoint {
    url            = "http://prometheus:9090/api/v1/write"
    send_exemplars = true
  }
}

// 로그 → Loki (push API)
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// 트레이스 → Tempo (OTLP gRPC)
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// ───────────────────────────── ① 메트릭: Actuator 를 가져감(pull) ─────────────────────────────

prometheus.scrape "drive" {
  targets = [{
    "__address__" = sys.env("DRIVE_METRICS_TARGETS"),
    "env"         = sys.env("DRIVE_ENV"),
  }]
  job_name        = "drive-api"
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// OS 지표(node_exporter 와 같은 것) — CPU·메모리·부하·네트워크.
// 리눅스 서버에서는 커널 지표가 호스트 전체 값이다. Docker Desktop(Windows·macOS)에서는 도커 VM 값이 나온다.
prometheus.exporter.unix "host" { }

// 내장 exporter 는 job="integrations/…" 를 스스로 붙이고 scrape 의 job_name 으로 바뀌지 않는다 — 대시보드·알림이 쓰는 이름으로 바꾼다
discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets
  rule {
    target_label = "job"
    replacement  = "node"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  job_name        = "node"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// DB 지표 — 별도 exporter 컨테이너 없이 Alloy 내장 exporter 로. (Drive 는 Redis 를 쓰지 않아 Redis 수집은 없다)
// PostgreSQL: 연결 수·트랜잭션·캐시 적중률·잠금·DB 크기 (pg_stat_* 읽기만 한다)
prometheus.exporter.postgres "drive" {
  data_source_names = [sys.env("DRIVE_PG_DSN")]
  // wal 수집기는 pg_ls_waldir 권한(pg_monitor)이 필요하다 — 앱 계정으로 붙으면 30초마다 권한 오류. 일반 계정으로 되는 것만 켠다
  //   pg_monitor 역할을 준 전용 계정이면 "wal" 을 더해도 된다
  enabled_collectors = ["database", "locks", "replication", "replication_slot", "stat_bgwriter", "stat_database", "stat_user_tables", "statio_user_tables"]
  // 앱 테이블에서 읽는 "지금 상태" 지표(진행 중 업로드 세션·스토리지 정리 대기열) — pg-queries.yaml
  custom_queries_config_path = "/etc/alloy/pg-queries.yaml"
}

discovery.relabel "postgres" {
  targets = prometheus.exporter.postgres.drive.targets
  rule {
    target_label = "job"
    replacement  = "postgres"
  }
}

prometheus.scrape "postgres" {
  targets         = discovery.relabel.postgres.output
  job_name        = "postgres"
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// 부하 테스트 DB(profile loadtest 의 loadtest-db) — 같은 compose 네트워크라 서비스 이름으로 붙는다.
// loadtest-db 가 꺼져 있으면 30초마다 접속 오류 로그가 남는다(무해). job 이 달라 "PostgreSQL 접속 불가" 알림과 무관
prometheus.exporter.postgres "loadtest" {
  data_source_names  = ["postgresql://drive_load:drive_load_pw@loadtest-db:5432/drive_load?sslmode=disable"]
  enabled_collectors = ["database", "locks", "stat_bgwriter", "stat_database", "stat_user_tables", "statio_user_tables"]
  custom_queries_config_path = "/etc/alloy/pg-queries.yaml"
}

// 부하 테스트 DB 의 쿼리별 누적 시간(pg_stat_statements 상위) — 확장이 있는 이 DB 에만. 기본 지표는 위 exporter 가 내므로 끈다
prometheus.exporter.postgres "loadtest_statements" {
  data_source_names          = ["postgresql://drive_load:drive_load_pw@loadtest-db:5432/drive_load?sslmode=disable"]
  disable_default_metrics    = true
  disable_settings_metrics   = true
  enabled_collectors         = []
  custom_queries_config_path = "/etc/alloy/pg-statements.yaml"
}

discovery.relabel "postgres_loadtest_statements" {
  targets = prometheus.exporter.postgres.loadtest_statements.targets
  rule {
    target_label = "job"
    replacement  = "postgres-loadtest"
  }
}

prometheus.scrape "postgres_loadtest_statements" {
  targets         = discovery.relabel.postgres_loadtest_statements.output
  job_name        = "postgres-loadtest"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

discovery.relabel "postgres_loadtest" {
  targets = prometheus.exporter.postgres.loadtest.targets
  rule {
    target_label = "job"
    replacement  = "postgres-loadtest"
  }
}

prometheus.scrape "postgres_loadtest" {
  targets         = discovery.relabel.postgres_loadtest.output
  job_name        = "postgres-loadtest"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// ───────────────────────────── ② OTLP 수신: 앱이 보냄(push) ─────────────────────────────
// 지금 Drive 는 트레이스만 OTLP 로 보낸다. 메트릭·로그도 OTLP 로 받을 수 있게 출구를 이어 둔다.

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    // 트레이스만 tail 샘플링을 거친다. 메트릭·로그는 전부 보낸다
    traces  = [otelcol.processor.tail_sampling.default.input]
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
  }
}

// tail 샘플링 — 앱은 모든 요청의 트레이스를 보내고(샘플링 1.0), 여기서 요청(trace) 단위로 남길지 정한다.
//   한 요청의 span 을 decision_wait 동안 모았다가 아래 정책 중 하나라도 맞으면 그 요청의 span 전부를 남기고, 아니면 전부 버린다.
//   - errors: span 상태가 ERROR (처리 안 된 예외)
//   - server_errors: 응답 5xx (예외 처리기가 응답을 만들어 span 이 ERROR 가 아닌 경우까지)
//   - slow: 첫 span 부터 마지막 span 까지 1초 이상
//   - sample: 나머지는 traceId 기준 10% — 같은 요청은 항상 같은 결정
// 주의: 같은 trace 의 span 은 한 Alloy 로 모여야 한다(지금은 서버당 Alloy 1대라 무관).
//   Tempo metrics_generator 의 span 메트릭은 남은 트레이스 기준이라 치우친다 — 요청 수·응답 시간은 Micrometer 메트릭(Prometheus)을 본다
otelcol.processor.tail_sampling "default" {
  // trace 의 첫 span 이 들어온 뒤 이 시간 안에 끝나지 않은 요청은 뒤늦게 온 에러 span 을 놓칠 수 있다(10초에서 5xx 31건 중 5건 유실).
  //   DB 장애 시 커넥션 대기(Hikari 30초)에 맞춘 값 — 그보다 오래 걸리는 요청은 여전히 놓칠 수 있다
  decision_wait = "30s"

  policy {
    name = "errors"
    type = "status_code"

    status_code {
      status_codes = ["ERROR"]
    }
  }

  policy {
    name = "server_errors"
    type = "string_attribute"

    string_attribute {
      key    = "outcome"
      values = ["SERVER_ERROR"]
    }
  }

  policy {
    name = "slow"
    type = "latency"

    latency {
      threshold_ms = 1000
    }
  }

  policy {
    name = "sample"
    type = "probabilistic"

    probabilistic {
      sampling_percentage = 10
    }
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

// 모아서 한 번에 보낸다(요청 수 감소)
otelcol.processor.batch "default" {
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.exporter.loki.default.input]
  }
}

otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

// ───────────────────────────── ③ 로그: 파일을 따라 읽음(tail) ─────────────────────────────
// 현재 파일(drive-server.log)만 읽는다. log4j2 가 굴린(rotate) 파일은 새 이름이라 같이 읽으면 중복된다.
// drive-error.log 는 drive-server.log 의 ERROR 부분집합이라 읽지 않는다.

local.file_match "drive" {
  path_targets = [{
    "__path__"     = "/var/log/drive/**/drive-server.log",
    "service_name" = "drive-api",
    "env"          = sys.env("DRIVE_ENV"),
  }]
  sync_period = "10s"
}

loki.source.file "drive" {
  targets    = local.file_match.drive.targets
  forward_to = [loki.process.drive.receiver]
}

loki.process "drive" {
  // 스택 트레이스 여러 줄을 한 건으로 — 날짜로 시작하는 줄이 새 로그
  stage.multiline {
    firstline     = `^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}`
    max_wait_time = "3s"
  }

  // 레벨 → 라벨(값 종류가 적어 라벨로 둔다)
  stage.regex {
    expression = `^\S+ \S+\s+(?P<level>[A-Z]+) `
  }
  stage.labels {
    values = { level = "" }
  }

  // traceId·spanId → 구조화 메타데이터(값 종류가 무한이라 라벨로 두면 안 된다). Grafana 에서 Tempo 로 넘어가는 링크가 된다
  stage.regex {
    expression = `\[(?P<trace_id>[0-9a-f]{32}),(?P<span_id>[0-9a-f]{16})\]`
  }
  stage.structured_metadata {
    values = {
      trace_id = "",
      span_id  = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}
