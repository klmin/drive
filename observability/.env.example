# observability/.env 로 복사해서 고친다(없으면 아래 기본값). docker compose 가 자동으로 읽는다.

# Alloy 가 메트릭을 가져갈 Drive 관리 포트(DRIVE_MANAGEMENT_PORT). 앱이 이 PC 에서 뜨면 host.docker.internal
DRIVE_METRICS_TARGETS=host.docker.internal:8091

# Drive 로그 폴더 — 앱의 LOG_PATH(기본 /log/drive/backend/drive-server) 상위 폴더. 그 아래 drive-server.log 를 읽는다
#   리눅스 서버 예: /log/drive
#   로컬(Windows) 예: C:/log/drive  (DriveAPI/.env 에서 logging.config=classpath:log/log4j2-server.yml 을 켰을 때의 기본 위치)
DRIVE_LOG_DIR=C:/log/drive

# Drive DB 지표(Alloy 내장 exporter). DSN 비밀번호 특수문자는 URL 인코딩(@ → %40, $ → %24, # → %23)
#   운영은 pg_monitor 역할만 준 전용 계정을 권장
DRIVE_PG_DSN=postgresql://<계정>:<비밀번호>@<DB 호스트>:5432/<DB 이름>?sslmode=disable

# 메트릭·로그에 붙는 환경 이름(local·dev·prod …)
DRIVE_ENV=local

PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=20GB
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
