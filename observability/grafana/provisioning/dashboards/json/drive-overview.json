{
  "uid": "drive-overview",
  "title": "Drive 개요",
  "tags": ["drive"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "인스턴스",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(jvm_info{job=\"drive-api\"}, instance)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "요청 수 (초당, URI별)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"drive-api\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "응답 시간 p95 (URI별) — 점을 누르면 트레이스",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{job=\"drive-api\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))))",
          "legendFormat": "{{method}} {{uri}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx 비율",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"drive-api\", instance=~\"$instance\", status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"drive-api\", instance=~\"$instance\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM 힙",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (jvm_memory_used_bytes{job=\"drive-api\", instance=~\"$instance\", area=\"heap\"})",
          "legendFormat": "사용 {{instance}}"
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (jvm_memory_max_bytes{job=\"drive-api\", instance=~\"$instance\", area=\"heap\"})",
          "legendFormat": "최대 {{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU (앱 프로세스 / 시스템)",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{job=\"drive-api\", instance=~\"$instance\"}",
          "legendFormat": "앱 {{instance}}"
        },
        {
          "refId": "B",
          "expr": "system_cpu_usage{job=\"drive-api\", instance=~\"$instance\"}",
          "legendFormat": "시스템 {{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB 커넥션 풀 (Hikari)",
      "gridPos": { "x": 0, "y": 15, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (hikaricp_connections_active{job=\"drive-api\", instance=~\"$instance\"})",
          "legendFormat": "사용 중 {{instance}}"
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (hikaricp_connections_pending{job=\"drive-api\", instance=~\"$instance\"})",
          "legendFormat": "대기 {{instance}}"
        },
        {
          "refId": "C",
          "expr": "sum by (instance) (hikaricp_connections_max{job=\"drive-api\", instance=~\"$instance\"})",
          "legendFormat": "최대 {{instance}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GC 멈춤 시간 (초당)",
      "gridPos": { "x": 8, "y": 15, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(jvm_gc_pause_seconds_sum{job=\"drive-api\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "호스트 메모리 사용률 (Alloy unix exporter)",
      "gridPos": { "x": 16, "y": 15, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "WARN·ERROR 로그 — trace_id 를 누르면 트레이스",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"drive-api\", level=~\"WARN|ERROR\"}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "PostgreSQL 세션 (상태별)",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (pg_stat_activity_count{job=\"postgres\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "PostgreSQL 트랜잭션 (초당) · 캐시 적중률",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "캐시 적중률" }, "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "custom.axisPlacement", "value": "right" } ] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_xact_commit{job=\"postgres\"}[$__rate_interval]))",
          "legendFormat": "커밋"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_database_xact_rollback{job=\"postgres\"}[$__rate_interval]))",
          "legendFormat": "롤백"
        },
        {
          "refId": "C",
          "expr": "sum(rate(pg_stat_database_blks_hit{job=\"postgres\"}[$__rate_interval])) / clamp_min(sum(rate(pg_stat_database_blks_hit{job=\"postgres\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{job=\"postgres\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "캐시 적중률"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "S3 커넥션 풀 — 연결 빌리는 시간 p95 · 대기 초과(503)/초",
      "description": "업로드 파트·다운로드·삭제가 같은 동기 S3 클라이언트 커넥션 풀(storage.http.max-connections, 기본 250)을 쓴다. 빌리는 시간이 오르면 풀이 모자란 것이고, 대기 초과(storage.http.connection-acquisition-timeout, 기본 2s)는 재시도 없이 503(STORAGE_009)이 된다. 대기는 없는데 S3 응답이 느리면 풀을 키우지 말고 입구 제한(다운로드 스트림 상한)을 낮춘다.",
      "gridPos": { "x": 0, "y": 39, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "대기 초과.*" }, "properties": [ { "id": "unit", "value": "reqps" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(drive_s3_http_acquire_seconds_bucket{job=\"drive-api\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "빌리는 시간 p95 {{instance}}"
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (rate(drive_s3_http_acquire_timeout_total{job=\"drive-api\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "대기 초과/초 {{instance}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "S3 커넥션 풀 — 빌린 연결 · 대기 요청 (구간 최대) · 풀 최대",
      "description": "SDK 는 요청이 끝날 때만 풀 상태를 알려 주므로 분포(drive_s3_http_leased·pending)의 구간 최대로 본다 — 부하가 없으면 값이 비고 마지막 값에 멈추지 않는다. 인스턴스별 값이며 스토리지가 받는 연결 수는 풀 × WAS 대수.",
      "gridPos": { "x": 8, "y": 39, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "풀 최대.*" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } } ] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (max_over_time(drive_s3_http_leased_max{job=\"drive-api\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "빌린 연결 {{instance}}"
        },
        {
          "refId": "B",
          "expr": "max by (instance) (max_over_time(drive_s3_http_pending_max{job=\"drive-api\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "대기 요청 {{instance}}"
        },
        {
          "refId": "C",
          "expr": "max by (instance) (drive_s3_http_max_connections{job=\"drive-api\", instance=~\"$instance\"})",
          "legendFormat": "풀 최대 {{instance}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "다운로드 스트림 — 동시 다운로드 · 상한 · 거절(503)/초",
      "description": "다운로드 본문은 스트림 스레드 풀(DriveStream-N, drive.download.stream.max-threads, 기본 200)이 보낸다. 사용 중 = 동시 다운로드 수. 상한에 닿으면 새 다운로드는 바로 503 으로 거절된다. 상한은 회선 대역폭 ÷ 1인당 최소 속도로 정하고, S3 풀은 그보다 크게(+업로드·삭제 몫) 둔다.",
      "gridPos": { "x": 16, "y": 39, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "상한.*" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } } ] },
          { "matcher": { "id": "byRegexp", "options": "거절.*" }, "properties": [ { "id": "unit", "value": "reqps" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (executor_active_threads{job=\"drive-api\", instance=~\"$instance\", name=\"driveStreamExecutor\"})",
          "legendFormat": "사용 중 {{instance}}"
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (executor_pool_max_threads{job=\"drive-api\", instance=~\"$instance\", name=\"driveStreamExecutor\"})",
          "legendFormat": "상한 {{instance}}"
        },
        {
          "refId": "C",
          "expr": "sum by (instance) (rate(drive_download_stream_rejected_total{job=\"drive-api\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "거절/초 {{instance}}"
        }
      ]
    }
  ]
}
