{
  "uid": "drive-k6-loadtest",
  "title": "k6 부하 테스트",
  "tags": ["drive", "k6"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "테스트",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(k6_vus, testid)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    { "id": 100, "type": "row", "title": "k6 (부하를 주는 쪽이 본 결과)", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    {
      "id": 1, "type": "timeseries", "title": "가상 사용자(VU) 수",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(k6_vus{testid=~\"$testid\"})", "legendFormat": "VU" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "요청 수 (초당, API별)",
      "gridPos": { "x": 6, "y": 1, "w": 9, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (api) (rate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "{{api}}" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "응답 시간 p95 (API별, k6 측정)",
      "gridPos": { "x": 15, "y": 1, "w": 9, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "max by (api) (k6_http_req_duration_p95{testid=~\"$testid\"})", "legendFormat": "{{api}}" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "실패율 · 체크 통과율",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max(k6_http_req_failed_rate{testid=~\"$testid\"})", "legendFormat": "HTTP 실패율" },
        { "refId": "B", "expr": "min(k6_checks_rate{testid=~\"$testid\"})", "legendFormat": "체크 통과율" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "응답 상태 코드 (초당)",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (status) (rate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "{{status}}" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "반복 1회 시간 p95 (생각 시간 포함)",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "max(k6_iteration_duration_p95{testid=~\"$testid\"})", "legendFormat": "p95" } ]
    },
    { "id": 101, "type": "row", "title": "서버 (WAS·DB·호스트) — 같은 시간대", "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    {
      "id": 7, "type": "timeseries", "title": "WAS 처리량·응답 시간 p95 (서버 측정) — 점을 누르면 트레이스",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": [ { "matcher": { "id": "byName", "options": "초당 요청" }, "properties": [ { "id": "unit", "value": "reqps" }, { "id": "custom.axisPlacement", "value": "right" } ] } ]
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"drive-api\"}[$__rate_interval])))", "legendFormat": "p95", "exemplar": true },
        { "refId": "B", "expr": "sum(rate(http_server_requests_seconds_count{job=\"drive-api\"}[$__rate_interval]))", "legendFormat": "초당 요청" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "DB 커넥션 풀 (Hikari)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(hikaricp_connections_active{job=\"drive-api\"})", "legendFormat": "사용 중" },
        { "refId": "B", "expr": "sum(hikaricp_connections_pending{job=\"drive-api\"})", "legendFormat": "대기" },
        { "refId": "C", "expr": "sum(hikaricp_connections_max{job=\"drive-api\"})", "legendFormat": "최대" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "부하 테스트 DB — 세션(상태별) · 초당 트랜잭션",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": [ { "matcher": { "id": "byName", "options": "초당 커밋" }, "properties": [ { "id": "custom.axisPlacement", "value": "right" } ] } ]
      },
      "targets": [
        { "refId": "A", "expr": "sum by (state) (pg_stat_activity_count{job=\"postgres-loadtest\", state=~\"active|idle in transaction\"})", "legendFormat": "{{state}}" },
        { "refId": "B", "expr": "sum(rate(pg_stat_database_xact_commit{job=\"postgres-loadtest\", datname=\"drive_load\"}[$__rate_interval]))", "legendFormat": "초당 커밋" }
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "CPU (WAS 프로세스 / 호스트)",
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max(process_cpu_usage{job=\"drive-api\"})", "legendFormat": "WAS 프로세스" },
        { "refId": "B", "expr": "max(system_cpu_usage{job=\"drive-api\"})", "legendFormat": "호스트(WAS 가 본 값)" }
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "JVM 힙 · GC 멈춤",
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": [ { "matcher": { "id": "byName", "options": "GC 멈춤(초/초)" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" } ] } ]
      },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"drive-api\", area=\"heap\"})", "legendFormat": "힙 사용" },
        { "refId": "B", "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=\"drive-api\"}[$__rate_interval]))", "legendFormat": "GC 멈춤(초/초)" }
      ]
    },
    { "id": 102, "type": "row", "title": "업로드 (upload.js) — k6 체감 시간 · 서버 세션 · S3 · 정리 대기열", "collapsed": false, "gridPos": { "x": 0, "y": 32, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 13, "type": "timeseries", "title": "파일 하나 올리는 시간 p95 (k6, 종류별) · 보낸 양",
      "description": "k6 커스텀 지표 upload_file_duration — 첫 요청부터 마지막 응답까지(청크는 세션 생성~complete). 오른쪽 축은 k6 가 보낸 바이트/초.",
      "gridPos": { "x": 0, "y": 33, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": [ { "matcher": { "id": "byName", "options": "보낸 양" }, "properties": [ { "id": "unit", "value": "Bps" }, { "id": "custom.axisPlacement", "value": "right" } ] } ]
      },
      "targets": [
        { "refId": "A", "expr": "max by (kind) (k6_upload_file_duration_p95{testid=~\"$testid\"})", "legendFormat": "{{kind}}" },
        { "refId": "B", "expr": "sum(rate(k6_data_sent_total{testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "보낸 양" }
      ]
    },
    {
      "id": 14, "type": "timeseries", "title": "업로드 세션 시작·종료 (초당, 서버)",
      "description": "앱 지표 — 시작 drive_upload_session_size_bytes_count{kind}(chunk = 청크 API, server = 기존 업로드 API·복사 등), 종료 drive_upload_session_ended_total{result, reason}. 시작보다 completed 가 적으면 실패·취소·진행 중.",
      "gridPos": { "x": 8, "y": 33, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (kind) (rate(drive_upload_session_size_bytes_count{job=\"drive-api\"}[$__rate_interval]))", "legendFormat": "시작 {{kind}}" },
        { "refId": "B", "expr": "sum by (result, reason) (rate(drive_upload_session_ended_total{job=\"drive-api\"}[$__rate_interval])) > 0", "legendFormat": "{{result}} {{reason}}" }
      ]
    },
    {
      "id": 15, "type": "timeseries", "title": "진행 중 업로드 세션 (DB 상태)",
      "description": "postgres exporter 커스텀 쿼리(alloy/pg-queries.yaml) — PENDING·COMPLETING 세션 수. 오른쪽 축은 가장 오래 활동 없는 세션의 경과 시간(TTL 1시간에 가까우면 버려진 업로드).",
      "gridPos": { "x": 16, "y": 33, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": [ { "matcher": { "id": "byRegexp", "options": "가장 오래.*" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" } ] } ]
      },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (drive_upload_active_sessions{job=\"postgres-loadtest\"})", "legendFormat": "{{status}}" },
        { "refId": "B", "expr": "max by (status) (drive_upload_active_oldest_idle_seconds{job=\"postgres-loadtest\"})", "legendFormat": "가장 오래 멈춘 {{status}}" }
      ]
    },
    {
      "id": 16, "type": "timeseries", "title": "S3 호출 p95 · 초당 (operation별) — 점을 누르면 트레이스",
      "description": "앱 지표 aws_s3_client_seconds(S3ObservationInterceptor). GetObject 는 응답 헤더까지(본문 읽기 제외). 같은 시간대 WAS p95 가 오르는데 여기도 오르면 스토리지 쪽.",
      "gridPos": { "x": 0, "y": 41, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": [ { "matcher": { "id": "byRegexp", "options": "초당 .*" }, "properties": [ { "id": "unit", "value": "reqps" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } } ] } ]
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, rpc_method) (rate(aws_s3_client_seconds_bucket{job=\"drive-api\"}[$__rate_interval])))", "legendFormat": "{{rpc_method}}", "exemplar": true },
        { "refId": "B", "expr": "sum by (rpc_method) (rate(aws_s3_client_seconds_count{job=\"drive-api\"}[$__rate_interval]))", "legendFormat": "초당 {{rpc_method}}" }
      ]
    },
    {
      "id": 17, "type": "timeseries", "title": "S3 오류 (초당) · 스토리지 정리 대기열",
      "description": "S3 오류 = aws_s3_client_seconds_count 중 error 가 none 이 아닌 것(404 는 정상 결과라 제외). 정리 대기열 = tb_storage_deletion(DELETE 객체 삭제 / ABORT_MULTIPART 미완성 업로드 정리) — 대기는 아직 처리할 행(24시간 유예·백오프로 미뤄 둔 행 포함), 기한 지남은 지울 시각이 15분 넘게 지났는데 남은 행, 포기는 시도 상한(10회)에 닿은 행. 부하 테스트 실행 구성은 배치 스케줄러가 꺼져 있어 대기 행이 모두 기한 지남으로 쌓인다.",
      "gridPos": { "x": 12, "y": 41, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": [ { "matcher": { "id": "byRegexp", "options": "S3 오류.*" }, "properties": [ { "id": "unit", "value": "reqps" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ]
      },
      "targets": [
        { "refId": "A", "expr": "sum by (rpc_method, http_status_code) (rate(aws_s3_client_seconds_count{job=\"drive-api\", error!=\"none\"}[$__rate_interval])) > 0", "legendFormat": "S3 오류 {{rpc_method}} {{http_status_code}}" },
        { "refId": "B", "expr": "sum by (action) (drive_storage_deletion_pending{job=\"postgres-loadtest\"})", "legendFormat": "정리 대기 {{action}}" },
        { "refId": "C", "expr": "sum by (action) (drive_storage_deletion_overdue{job=\"postgres-loadtest\"})", "legendFormat": "기한 지남 {{action}}" },
        { "refId": "D", "expr": "sum by (action) (drive_storage_deletion_exhausted{job=\"postgres-loadtest\"}) > 0", "legendFormat": "포기 {{action}}" }
      ]
    },
    { "id": 104, "type": "row", "title": "다운로드 (download.js) — 체감 시간 · 서버 처리 시간 · 스트리밍 스레드", "collapsed": false, "gridPos": { "x": 0, "y": 50, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 22, "type": "timeseries", "title": "다운로드 시간 p95 (k6, 종류별) · 받은 양",
      "description": "k6 커스텀 지표 download_file_duration — 토큰 발급부터 마지막 바이트까지(kind: small / large / zip). 오른쪽 축은 k6 가 받은 바이트/초.",
      "gridPos": { "x": 0, "y": 51, "w": 8, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": [ { "matcher": { "id": "byName", "options": "받은 양" }, "properties": [ { "id": "unit", "value": "Bps" }, { "id": "custom.axisPlacement", "value": "right" } ] } ]
      },
      "targets": [
        { "refId": "A", "expr": "max by (kind) (k6_download_file_duration_p95{testid=~\"$testid\"})", "legendFormat": "{{kind}}" },
        { "refId": "B", "expr": "sum(rate(k6_data_received_total{testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "받은 양" }
      ]
    },
    {
      "id": 23, "type": "timeseries", "title": "다운로드 처리 시간 p95 (서버, 경로별) — 점을 누르면 트레이스",
      "description": "http_server_requests 중 /download 경로. 스트리밍(StreamingResponseBody)은 비동기라 본문을 다 보낼 때까지가 처리 시간이다. 파일·폴더(zip)·여러 항목·버전 다운로드를 경로별로.",
      "gridPos": { "x": 8, "y": 51, "w": 8, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": [ { "matcher": { "id": "byRegexp", "options": "초당 .*" }, "properties": [ { "id": "unit", "value": "reqps" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } } ] } ]
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"drive-api\", uri=~\".+/download\"}[$__rate_interval])))", "legendFormat": "{{uri}}", "exemplar": true },
        { "refId": "B", "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"drive-api\", uri=~\".+/download\"}[$__rate_interval]))", "legendFormat": "초당 {{uri}}" }
      ]
    },
    {
      "id": 24, "type": "timeseries", "title": "스레드 — 다운로드 스트림 · Tomcat 요청 스레드 · JVM 전체 · 처리 중 요청",
      "description": "다운로드 본문은 Tomcat 요청 스레드가 아니라 다운로드 스트림 풀(DriveStream-N, StreamingAsyncConfig — executor_*{name=\"driveStreamExecutor\"})이 흘려보낸다. 동시 다운로드 수 = 스트림 사용 중. 최대에 닿으면 새 다운로드는 503 으로 거절된다(거절/초 — drive_download_stream_rejected_total). 처리 중 요청은 끝나기 전이라 경로를 모른다(uri=UNKNOWN) — 전체 합.",
      "gridPos": { "x": 16, "y": 51, "w": 8, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".* 최대" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } } ] }, { "matcher": { "id": "byName", "options": "스트림 거절/초" }, "properties": [ { "id": "unit", "value": "reqps" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "targets": [
        { "refId": "A", "expr": "sum(tomcat_threads_busy_threads{job=\"drive-api\"})", "legendFormat": "Tomcat 사용 중" },
        { "refId": "B", "expr": "sum(tomcat_threads_config_max_threads{job=\"drive-api\"})", "legendFormat": "Tomcat 최대" },
        { "refId": "C", "expr": "sum(jvm_threads_live_threads{job=\"drive-api\"})", "legendFormat": "JVM 전체 스레드" },
        { "refId": "D", "expr": "sum(http_server_requests_active_seconds_gcount{job=\"drive-api\"})", "legendFormat": "처리 중 요청" },
        { "refId": "E", "expr": "sum(executor_active_threads{job=\"drive-api\", name=\"driveStreamExecutor\"})", "legendFormat": "스트림 사용 중" },
        { "refId": "F", "expr": "sum(executor_pool_max_threads{job=\"drive-api\", name=\"driveStreamExecutor\"})", "legendFormat": "스트림 최대" },
        { "refId": "G", "expr": "sum(rate(drive_download_stream_rejected_total{job=\"drive-api\"}[$__rate_interval]))", "legendFormat": "스트림 거절/초" }
      ]
    },
    { "id": 105, "type": "row", "title": "S3 커넥션 풀 (업로드·다운로드 공용 동기 클라이언트, storage.http.*)", "collapsed": false, "gridPos": { "x": 0, "y": 60, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 25, "type": "timeseries", "title": "S3 연결 빌리는 시간 p95·p99 · 대기 초과(503)/초",
      "description": "업로드 파트·다운로드·삭제가 같은 동기 S3 클라이언트의 커넥션 풀(S3ClientConfig, storage.http.max-connections)을 쓴다. 빌리는 시간이 오르면 풀이 모자란 것 — 대기 초과(storage.http.connection-acquisition-timeout)는 재시도 없이 503(STORAGE_009)이 된다(drive_s3_http_acquire_timeout_total). 대기는 사라졌는데 S3 호출 시간이 오르면 풀을 더 키우지 말고 입구 제한(다운로드 스트림 상한 등)을 낮춘다.",
      "gridPos": { "x": 0, "y": 61, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [ { "matcher": { "id": "byName", "options": "대기 초과/초" }, "properties": [ { "id": "unit", "value": "reqps" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(drive_s3_http_acquire_seconds_bucket{job=\"drive-api\"}[$__rate_interval])))", "legendFormat": "빌리는 시간 p95" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(drive_s3_http_acquire_seconds_bucket{job=\"drive-api\"}[$__rate_interval])))", "legendFormat": "빌리는 시간 p99" },
        { "refId": "C", "expr": "sum(rate(drive_s3_http_acquire_timeout_total{job=\"drive-api\"}[$__rate_interval]))", "legendFormat": "대기 초과/초" }
      ]
    },
    {
      "id": 26, "type": "timeseries", "title": "S3 빌린 연결 · 대기 요청 (구간 최대) · 풀 최대",
      "description": "SDK 는 시도가 끝날 때만 풀 상태를 알려 주므로 게이지가 아니라 분포(drive_s3_http_leased·pending)로 남기고 구간 최대(max_over_time)로 본다 — 부하가 끝나면 값이 없어진다(마지막 값에 멈추지 않음). WAS 인스턴스별 값이고, 스토리지가 받는 연결은 풀 × WAS 대수.",
      "gridPos": { "x": 8, "y": 61, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*풀 최대" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } } ] } ] },
      "targets": [
        { "refId": "A", "expr": "max by (instance) (max_over_time(drive_s3_http_leased_max{job=\"drive-api\"}[$__rate_interval]))", "legendFormat": "{{instance}} 빌린 연결" },
        { "refId": "B", "expr": "max by (instance) (max_over_time(drive_s3_http_pending_max{job=\"drive-api\"}[$__rate_interval]))", "legendFormat": "{{instance}} 대기 요청" },
        { "refId": "C", "expr": "max by (instance) (drive_s3_http_max_connections{job=\"drive-api\"})", "legendFormat": "{{instance}} 풀 최대" }
      ]
    },
    {
      "id": 27, "type": "timeseries", "title": "S3 연결을 빌린 호출 (초당) · 평균 빌린 연결",
      "description": "초당 연결 획득 수(시도 단위, 재시도 포함)와 그 순간 빌려 간 연결 수의 평균. 다운로드는 본문을 다 보낼 때까지 연결을 잡고 있어 빌린 연결 수 ≈ 동시 다운로드 + 진행 중 파트 업로드.",
      "gridPos": { "x": 16, "y": 61, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [ { "matcher": { "id": "byName", "options": "평균 빌린 연결" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "custom.axisPlacement", "value": "right" } ] } ] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(drive_s3_http_acquire_seconds_count{job=\"drive-api\"}[$__rate_interval]))", "legendFormat": "획득/초" },
        { "refId": "B", "expr": "sum(rate(drive_s3_http_leased_sum{job=\"drive-api\"}[$__rate_interval])) / sum(rate(drive_s3_http_leased_count{job=\"drive-api\"}[$__rate_interval]))", "legendFormat": "평균 빌린 연결" }
      ]
    },
    { "id": 103, "type": "row", "title": "DB 잠금·느린 쿼리 (write.js 등 쓰기 부하) — 부하 테스트 DB", "collapsed": false, "gridPos": { "x": 0, "y": 69, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 18, "type": "timeseries", "title": "잠금 대기 · 교착",
      "description": "잠금을 기다리는 세션 수와 그중 가장 오래 기다린 시간(alloy/pg-queries.yaml), 교착(deadlock) 초당 횟수(pg_stat_database). HOT_USER=1 로 같은 사용자를 두드리면 여기서 경합이 보인다.",
      "gridPos": { "x": 0, "y": 70, "w": 8, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "가장 오래 대기" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" } ] },
          { "matcher": { "id": "byName", "options": "교착 (초당)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "targets": [
        { "refId": "A", "expr": "max(drive_pg_lock_wait_sessions{job=\"postgres-loadtest\"})", "legendFormat": "잠금 대기 세션" },
        { "refId": "B", "expr": "max(drive_pg_lock_wait_max_seconds{job=\"postgres-loadtest\"})", "legendFormat": "가장 오래 대기" },
        { "refId": "C", "expr": "sum(rate(pg_stat_database_deadlocks{job=\"postgres-loadtest\", datname=\"drive_load\"}[$__rate_interval]))", "legendFormat": "교착 (초당)" }
      ]
    },
    {
      "id": 19, "type": "timeseries", "title": "DB 시간을 가장 많이 쓰는 쿼리 (초당 실행 시간, 상위 8)",
      "description": "pg_stat_statements 상위 20개(alloy/pg-statements.yaml) 중 구간 동안 실행 시간 합이 큰 것. 1 = DB 가 1초에 1초씩 그 쿼리를 실행 중(여러 세션 합). 테스트 사이에 SELECT pg_stat_statements_reset(); 로 비운다.",
      "gridPos": { "x": 8, "y": 70, "w": 16, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "topk(8, sum by (queryid, query) (rate(drive_pg_statements_seconds{job=\"postgres-loadtest\"}[$__rate_interval])))", "legendFormat": "{{query}} · {{queryid}}" }
      ]
    },
    {
      "id": 20, "type": "timeseries", "title": "1회 평균 실행 시간 (느린 쿼리, 상위 8)",
      "description": "reset 이후 누적 평균. 호출이 적어도 한 번이 느린 쿼리 — 인덱스·실행 계획을 본다.",
      "gridPos": { "x": 0, "y": 79, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "topk(8, max by (queryid, query) (drive_pg_statements_mean_seconds{job=\"postgres-loadtest\"}))", "legendFormat": "{{query}} · {{queryid}}" }
      ]
    },
    {
      "id": 21, "type": "timeseries", "title": "초당 호출 수 (많이 불리는 쿼리, 상위 8)",
      "description": "한 요청에 같은 쿼리가 여러 번(N+1)이면 여기서 초당 호출이 k6 초당 요청보다 훨씬 크게 나온다.",
      "gridPos": { "x": 12, "y": 79, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] } },
      "targets": [
        { "refId": "A", "expr": "topk(8, sum by (queryid, query) (rate(drive_pg_statements_calls{job=\"postgres-loadtest\"}[$__rate_interval])))", "legendFormat": "{{query}} · {{queryid}}" }
      ]
    },
    {
      "id": 12, "type": "logs", "title": "부하 중 WARN·ERROR 로그",
      "gridPos": { "x": 0, "y": 87, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [ { "refId": "A", "expr": "{service_name=\"drive-api\", level=~\"WARN|ERROR\"}" } ]
    }
  ]
