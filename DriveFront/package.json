{
    "name": "drive_front",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -H 0.0.0.0 -p 3000 --turbopack",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "prebuild": "node scripts/generate-env.js",
        "perf:dev": "cross-env NEXT_PUBLIC_PERF_MODE=1 NEXT_PUBLIC_PERF_DATASET=500 next dev -H 0.0.0.0 -p 3000",
        "perf:dev:1000": "cross-env NEXT_PUBLIC_PERF_MODE=1 NEXT_PUBLIC_PERF_DATASET=1000 next dev -H 0.0.0.0 -p 3000",
        "perf:start": "cross-env NEXT_PUBLIC_PERF_MODE=1 NEXT_PUBLIC_PERF_DATASET=500 next build && npx serve@latest out"
    },
    "dependencies": {
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/server": "^11.11.0",
        "@emotion/styled": "^11.14.0",
        "@mui/icons-material": "^7.1.2",
        "@mui/material": "^7.1.2",
        "@mui/x-date-pickers": "^8.7.0",
        "@mui/x-tree-view": "^8.6.0",
        "axios": "1.18.1",
        "dayjs": "^1.11.13",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.1",
        "install": "^0.13.0",
        "js-cookie": "^3.0.8",
        "just-debounce-it": "^3.2.0",
        "next": "15.5.18",
        "next-intl": "^4.13.2",
        "pretendard": "^1.3.9",
        "prettier": "^3.6.2",
        "qrcode.react": "^4.2.0",
        "react": "^19.0.0",
        "react-cookie": "^8.0.1",
        "react-dom": "^19.0.0",
        "react-virtuoso": "^4.18.1",
        "uuid": "^13.0.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "cross-env": "^10.1.0",
        "eslint": "^9",
        "eslint-config-next": "15.5.18",
        "eslint-config-prettier": "^10.1.8",
        "msw": "^2.12.7"
    },
    "overrides": {
        "postcss": "8.5.10"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
