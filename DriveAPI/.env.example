# 로컬 실행 설정 — 이 파일을 DriveAPI/.env 로 복사하면 그대로 실행된다(.env 는 git 제외, 개인 값은 .env 에서만 고친다).
# 실행: IntelliJ 공유 실행 구성 DriveAPI(.run/DriveAPI.run.xml) 를 고른다 — VM 옵션으로 이 .env 를 읽는다.
# 형식: properties(KEY=VALUE) — export·따옴표 없이 쓴다(따옴표는 값이 된다). 특수문자(@·$·#) 비밀번호도 그대로 적는다.
# 다른 IDE·터미널, IntelliJ Edit Configurations 로 넣는 방법(따옴표 규칙이 다름)·주의·우선순위는 ENV_VARIABLES.md 3번.

# 인프라: DB·스토리지는 로컬 도커로 띄운다 — cd DriveAPI && docker compose -f docker-compose.local.yml up -d
#   아래 값은 docker-compose.local.yml 의 계정과 같다. 빈 DB 는 Flyway 가 V1 부터 만든다

# DB (로컬 도커 PostgreSQL)
DRIVE_DATABASE_HOST=localhost
DRIVE_DATABASE_PORT=5432
DRIVE_DATABASE_NAME=drive
DRIVE_DATABASE_USERNAME=drive
DRIVE_DATABASE_PASSWORD=drive_local_pw
# Flyway: 예전 initialize.sql 로 만든 DB(이력 테이블 없음)를 V1 적용됨으로 인정(baseline)하고 V2 부터 적용한다.
#   이력 테이블 없는 기존 DB 에 붙을 때만 푼다(빈 로컬 도커 DB 는 필요 없음). 서버·설치기 기본은 false
#DRIVE_FLYWAY_BASELINE_ON_MIGRATE=true

# 스토리지 (로컬 도커 RustFS — S3 호환, 용량 조회는 무제한으로 보고)
DRIVE_STORAGE_TYPE=rustfs
DRIVE_STORAGE_ENDPOINT=http://localhost:9000
DRIVE_STORAGE_REGION=ap-northeast-2
DRIVE_STORAGE_ACCESS_KEY=drive_local
DRIVE_STORAGE_SECRET_KEY=drive_local_secret
DRIVE_STORAGE_BUCKET_NAME=drive-local

# 초기 설정(InitialSetupRunner)
#   쓸 때만 주석을 풀고 값을 채운다. 토큰·secret 실제 값은 이 파일(커밋됨)에 적지 않는다
#DRIVE_INITIAL_LICENSE_FILE=<라이선스 .tfl 절대 경로>
#DRIVE_INITIAL_OFFICE_DOMAIN=<TFO 주소, 예: https://office.example.com>
#DRIVE_INITIAL_OFFICE_ADAPTER_NAME=<TFO HTTP Storage 어댑터 이름>
#DRIVE_INITIAL_OFFICE_AUTH_MODE=ticket
#DRIVE_INITIAL_OFFICE_CONNECTION_TYPE=onPremise
#DRIVE_INITIAL_OFFICE_TICKET_SERVICE_TOKEN=<TFO 티켓 서비스 토큰>
#DRIVE_INITIAL_OFFICE_HTTP_STORAGE_REQUEST_JWT_SECRET=<HTTP Storage 요청 서명 secret, 32바이트 이상>

# 프론트·공유 링크
DRIVE_FRONT_BASE_URL=http://localhost:3000
# 프론트 개발 서버(3000)로 링크를 만들 때만 푼다 — 비우면 요청 포트(8080) 그대로
#app.front.port=3000
DRIVE_SHARE_CONTEXT_PATH=/s/
# 로컬 http 개발 — FE 개발 서버 origin 허용, Secure 쿠키 끔
DRIVE_CORS_ALLOWED_ORIGINS=http://localhost:3000
DRIVE_AUTH_COOKIE_SECURE=false

# 로컬 동작 스위치
# 테넌트 미판별 시 기본 테넌트로 대체
DRIVE_TENANT_DEV_FALLBACK_ENABLED=true
# 공유 DB 배치 스케줄러 끔
DRIVE_SCHEDULER_BATCH_ENABLED=false
# FE/BE URL 을 요청 포트 기준으로 조립(LocalClientDomainService)
drive.client-domain.mode=local
# 외부 호출 요청·응답 본문 로그(RestRequestInterceptor)
DRIVE_REST_CLIENT_TRACE_ENABLED=true
# 라이선스 파일이 없을 때만 — 라이선스 검사 끔(사용자 로그인 차단 해제, 운영은 절대 false 금지)
#DRIVE_LICENSE_ENFORCEMENT_ENABLED=false

# 로그 — 콘솔 전용, tomcat 접근 로그 끔, p6spy SQL 로그 켬(SqlLogListener)
logging.config=classpath:log/log4j2-local.yml
logging.level.com.thinkfree.drive.auditlog.sender.impl.GovernanceSdkAuditLogSender=DEBUG
DRIVE_WEB_LOG_ENABLED=false
decorator.datasource.enabled=true
decorator.datasource.p6spy.enable-logging=false

# 관측성 — 리포 observability/ 스택(docker compose)을 띄웠을 때만 푼다. 설명은 observability/README.md
# 관리 포트(/actuator/prometheus) — 기본 8091. 같은 PC 에서 인스턴스를 둘 띄우면 다르게
#DRIVE_MANAGEMENT_PORT=8091
#DRIVE_OTLP_TRACING_EXPORT_ENABLED=true
#DRIVE_TRACING_SAMPLING_PROBABILITY=1.0
# 로그를 Loki 로 보내려면 파일로도 남긴다(위 log4j2-local.yml 은 콘솔 전용). 아래 한 줄을 풀면 콘솔 + C:/log/drive/backend/drive-server.log
#   그리고 observability/.env 에 DRIVE_LOG_DIR=C:/log/drive. 경로를 바꾸려면 LOG_PATH 를 .env 가 아니라 실행 구성의 "환경 변수"로 준다(log4j2 가 env 로만 읽는다)
#logging.config=classpath:log/log4j2-server.yml

# 감사 로그 → 로컬 Governance 서버(TFDRIVE-1612). endpoint 포트는 로컬 governance 설치값(setup 의 -ServerPort)
GOVERNANCE_AUDIT_ENABLED=true
GOVERNANCE_ORIGIN_INSTANCE_ID=tfd-local
GOVERNANCE_SDK_ENDPOINT=http://localhost:8082/v1
GOVERNANCE_SDK_TENANT_ID=3ac5c549-8812-4aab-b7bb-78028294f713
GOVERNANCE_SDK_KEY_ID=45e2ea4e-ccb4-43d4-9dd4-6ae35c707b6e
GOVERNANCE_SDK_BASE64_SECRET=7y/NyFiiIFJhvgiWQpLTNHBtZUtK2qdFiAelUniaDNA

# 서명·암호화 키 — 로컬은 기존 값 그대로(공용 dev DB 와 같은 SMTP AES 키라 바꾸지 않는다). 서버는 generate_secret_keys.sh 로 만든다(ENV_VARIABLES.md 1-3)
DRIVE_JWT_SECRET_KEY=c2lsdmVybmluZS10ZWNoLXNwcmluZy1ib290LWp3dC10dXRvcmlhbC1zZWNyZXQtclh
DRIVE_SMTP_AES_SECRET_KEY=F4r1cG8tL7pXq9zYvB2eW6hK3uJnMdPs
DRIVE_DOWNLOAD_SECRET_KEY=N2Y5ZGNmMTAtNTU5Yi00N2IwLWE3MzAtYjA3Y2I1NzYyZWQ5LThmYzJhNzcxMQ==
