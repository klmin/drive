</dependency>

        <!-- Spring Boot Starter for JDBC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>
        <!-- Spring Data JPA(Hibernate) — 2단계 쓰기 리포 위임용. JdbcClient 와 공존(JpaTransactionManager 하나에 JdbcClient·JPA 가 같이 참여) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- jOOQ — 엔티티를 고치지 않는 SQL(조회·upsert·배치·벌크)용. 버전은 Boot 관리(3.19.x, 소스 레벨 17). 생성 코드는 src/main/jooq(커밋), 재생성은 -Pjooq-codegen -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
        <!-- Flyway — 기동 시 스키마·기초 데이터 마이그레이션(src/main/resources/db/migration). 버전은 Boot 관리, Flyway 10+ 는 PG 지원이 별도 모듈 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- p6spy — DataSource 래핑 SQL 로그(JPA·JdbcClient 전부, 실행시간·바인딩 값 포함). 1.12.x = Boot 3.5 계열(2.x 는 Boot 4). 켜는 건 local 프로필만 -->
        <dependency>
            <groupId>com.github.gavlyukovskiy</groupId>
            <artifactId>p6spy-spring-boot-starter</artifactId>
            <version>1.12.1</version>
        </dependency>
        <!-- Spring Boot Starter for Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 관측성(observability/) — Actuator: /actuator/health·prometheus 노출(관리 포트 management.server.port), Micrometer 는 함께 들어옴.
             registry-prometheus: 메트릭을 Prometheus 형식으로(Alloy 가 가져감). tracing-bridge-otel + exporter-otlp: 트레이스를 OTLP 로 Alloy 에 보냄.
             버전은 모두 Boot 관리 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- SQL 실행을 트레이스 구간(span)으로 — DataSource 를 datasource-proxy 로 감싼다(JdbcObservationConfig). 1.1.x = Boot 3.4+ 계열(1.2.x 는 Boot 4).
             -spring-boot 모듈은 p6spy 데코레이터와 빈 이름(dataSourceNameResolver)이 겹쳐 기동 실패 — 코어만 쓰고 감싸기는 직접 한다 -->
        <dependency>
            <groupId>net.ttddyy.observation</groupId>
            <artifactId>datasource-micrometer</artifactId>
            <version>1.1.2</version>
        </dependency>
        <!-- datasource-proxy 를 넣으면 p6spy 데코레이터(1.12.1)도 자기 datasource-proxy 연동을 켜는데, 그쪽은 1.11 의 LoggingFilter 를 쓴다
             (datasource-micrometer 기본 1.10.1 이면 decorator.datasource.enabled=true 인 로컬에서 기동 실패) — 1.11.0 으로 맞춘다 -->
        <dependency>
            <groupId>net.ttddyy</groupId>
            <artifactId>datasource-proxy</artifactId>
            <version>1.11.0</version>
        </dependency>
        <!-- PostgreSQL JDBC Driver -->
        <dependency>
