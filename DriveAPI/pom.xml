    <!-- Governance SDK는 Maven Central에 배포되지 않아 전달본(zip)을 푼 파일 기반 저장소를 쓴다. -->
    <repositories>
        <repository>
            <id>governance-sdk-file</id>
            <url>file://${project.basedir}/governance-sdk/repository</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
